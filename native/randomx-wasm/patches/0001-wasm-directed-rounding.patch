+// WebAssembly has no rounding-mode control, so the mode lives here and the
+// floating-point operations in intrin_portable.h round in software.
+extern "C" int rx_wasm_round_mode;
+int rx_wasm_round_mode = RoundToNearest;
+
+void rx_reset_float_state() {
+	rx_wasm_round_mode = RoundToNearest;
+}
+
+void rx_set_rounding_mode(uint32_t mode) {
+	rx_wasm_round_mode = (int)(mode & 3);
+}
+
+uint32_t rx_get_rounding_mode() {
+	return (uint32_t)rx_wasm_round_mode;
+}
